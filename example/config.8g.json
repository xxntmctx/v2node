{
  "Log": {
    "Level": "warning",
    "Output": "/etc/v2node/v2node.log",
    "Access": "none"
  },
  "PprofPort": 6060,
  "Gogc": 100,
  "MemLimit": 6800000000,
  "Policy": {
    "Handshake": 4,
    "ConnectionIdle": 300,
    "UplinkOnly": 2,
    "DownlinkOnly": 4,
    "BufferSize": 32
  },
  "Monitor": {
    "Enable": true,
    "Interval": 30,
    "LogThreshold": 300
  },
  "Nodes": [
    {
      "ApiHost": "https://your-panel.com",
      "NodeID": 1,
      "ApiKey": "your_api_key",
      "NodeType": "vless",
      "CustomConfigPath": "/etc/v2node/custom.json",
      "Timeout": 30
    }
  ]
}
